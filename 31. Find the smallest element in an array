#include <stdio.h>

int main()
{
    int a[100], n, smallest;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    smallest = a[0];

    for (int i = 1; i < n; i++)
    {
        if (a[i] < smallest)
            smallest = a[i];
    }

    printf("Smallest element = %d", smallest);

    return 0;
}
